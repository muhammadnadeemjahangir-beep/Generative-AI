rammingFundamentals":"พื้นฐาน R Programming","shinyFundamentals":"พื้นฐาน Shiny","snowflakeFoundations":"Snowflake Foundations","spreadsheetFundamentals":"Spreadsheet Fundamentals","sqlForBusinessAnalysts":"SQL สำหรับ Business Analyst","sqlForDatabaseAdministrators":"SQL สำหรับผู้ดูแลระบบฐานข้อมูล","sqlFundamentals":"พื้นฐาน SQL","sqlServerForDatabaseAdministrators":"SQL Server สำหรับผู้ดูแลฐานข้อมูล","sqlServerFundamentals":"SQL Server Fundamentals","tableauFundamentals":"Tableau Fundamentals","tidyverseFundamentalsWithR":"พื้นฐาน Tidyverse ด้วย R","understandingCloudComputing":"ทำความเข้าใจ Cloud Computing","understandingDataEngineering":"ทำความเข้าใจ Data Engineering","understandingDataScience":"ทำความเข้าใจ Data Science","understandingDataVisualization":"ทำความเข้าใจ Data Visualization","understandingMachineLearning":"ทำความเข้าใจ Machine Learning"},"TracksPanel":{"careerTracks":"Career Tracks","seeAllCareerTracks":"ดูเส้นทางการเรียนด้านอาชีพทั้งหมด","seeAllSkillTracks":"ดู Skill Track ทั้งหมด","skillTracks":"เส้นทางทักษะ"},"WorkspaceDocs":{"creatingAPublication":{"description":"เพื่อแชร์งานกับเพื่อนหรือแสดงบนหน้าโปรไฟล์ คุณสามารถสร้าง publication จาก workspace และควบคุมวิธีที่ผู้อื่นค้นพบงานของคุณ","label":"การสร้างสิ่งพิมพ์"},"creatingAWorkspace":{"description":"workspace คือกลุ่มไฟล์ source ข้อมูล และการกำหนดค่าที่แสดงถึงงานทั้งหมดที่คุณทำสำหรับงานหรือโปรเจกต์การวิเคราะห์ข้อมูลที่กำหนด","label":"การสร้าง Workspace"},"gettingStarted":{"description":"บทช่วยสอนนี้ช่วยให้คุณเข้าถึง DataLab สร้าง workspace จากเทมเพลต และเผยแพร่ เวลาที่คาดว่าจะใช้: 10 นาที","label":"เริ่มต้นใช้งาน"},"support":{"description":"เรารักทุกความคิดเห็น! หากมีข้อเสนอแนะว่าเราจะปรับปรุงผลิตภัณฑ์ได้อย่างไร ฝากข้อความไว้ให้เราได้เลย","label":"ฝ่ายสนับสนุน"},"whatIsDataCampWorkspace":{"description":"DataLab คือ IDE ออนไลน์ที่ให้คุณเขียนโค้ดและวิเคราะห์ข้อมูลร่วมกันได้ และแชร์ข้อมูลเชิงลึกของคุณ","label":"DataLab คืออะไร?"}},"WorkspaceIntegrations":{"dropbox":{"description":"หากต้องการทดลองใช้การเชื่อมต่อนี้ด้วยการเข้าถึงไฟล์ข้อมูลที่กำหนดไว้ล่วงหน้า คุณสามารถข้ามส่วนถัดไปและไปที่หัวข้อถัดไปได้เลย","label":"Dropbox"},"github":{"description":"คุณสามารถตั้งค่า GitHub username และ password เป็น environment variables ได้","label":"Github"},"postgresql":{"description":"ในการ query ฐานข้อมูล PostgreSQL จากภายใน DataLab ขั้นตอนแรกคือการสร้าง integration เพื่อเชื่อมต่อกับฐานข้อมูล","label":"PostgreSQL"},"redshift":{"description":"เพื่อ query ฐานข้อมูล Redshift จากภายใน DataLab ขั้นตอนแรกคือการสร้าง integration เพื่อเชื่อมต่อกับฐานข้อมูล","label":"Redshift"},"s3Bucket":{"description":"ในการเชื่อมต่อพื้นที่ทำงานกับ AWS S3 bucket คุณจะต้องมีชื่อ bucket และข้อมูลรับรองของบัญชี AWS","label":"S3 Bucket"}},"WorkspacePanel":{"description":"สร้างพอร์ตโฟลิโอด้านข้อมูลด้วยโน้ตบุ๊กข้อมูลที่ขับเคลื่อนด้วย AI ของ DataCamp","imageAltText":"ทำงานร่วมกันและแชร์แบบเรียลไทม์","seeAllTemplates":"ดูเทมเพลตทั้งหมด"},"WorkspaceTemplates":{"datasetPythonECommerce":{"description":"วิเคราะห์ข้อมูลคำสั่งซื้อจากร้านค้าปลีกของขวัญออนไลน์ที่ดำเนินการในหลายประเทศ","label":"ข้อมูล E-Commerce"},"datasetPythonGooglePlayStoreApps":{"description":"วิเคราะห์ข้อมูลเกี่ยวกับแอปและรีวิวของแอป","label":"แอปใน Google Play Store"},"datasetPythonNetflixMovieData":{"description":"วิเคราะห์ข้อมูล เช่น ความยาว คำอธิบาย นักแสดง ประเทศ เป็นต้น ของภาพยนตร์และรายการทีวีกว่า 8,000 รายการบน Netflix","label":"ข้อมูลภาพยนตร์ Netflix"},"playbookPythonMultipleTimeSeries":{"description":"เพิ่มความเข้าใจเชิงลึกเกี่ยวกับข้อมูลอนุกรมเวลาของคุณผ่านการแสดงผลหลายรูปแบบ","label":"วิเคราะห์อนุกรมเวลาหลายชุด"},"playbookPythonNetworkAnalysis":{"description":"ทำการวิเคราะห์เครือข่ายโดยใช้แพ็กเกจ NetworkX","label":"Network Analysis"},"playbookPythonSentimentAnalysis":{"description":"เข้าใจและทำนายความคิดเห็นของผู้เขียนเกี่ยวกับหัวข้อหนึ่งๆ","label":"การทำนายการวิเคราะห์ความรู้สึก"},"pythonMeasles":{"description":"วิเคราะห์ข้อมูลการฉีดวัคซีนโรคหัดจากโรงเรียนในสหรัฐอเมริกา","label":"ข้อมูลโรคหัด"},"recipePythonKMeans":{"description":"ระบุและแสดงผลกลุ่มข้อมูลในชุดข้อมูลของคุณ","label":"ค้นหาและแสดงผล Cluster ด้วย K-Means"},"recipePythonTimeSeriesShifts":{"description":"คำนวณ shifts และ lags และแสดงภาพการเปลี่ยนแปลงเป็นเปอร์เซ็นต์ในช่วงเวลาต่างๆ","label":"คำนวณการเปลี่ยนแปลงเป็นเปอร์เซ็นต์ Lags และ Shifts บน Time Series"},"recipePythonVisualize2DHeatmapWithHistogram":{"description":"แสดงขนาดของปรากฏการณ์ผ่านการเปลี่ยนแปลงของเฉดสีและความเข้มในสองมิติ","label":"สร้างภาพ Heatmap"},"recipePythonWordCloud":{"description":"แสดงภาพคำที่พบบ่อยที่สุดในไฟล์ข้อความด้วย Word Cloud","label":"สร้าง Word Cloud"}},"aiForBusiness":"AI for Business","aiForEducators":"AI สำหรับนักการศึกษา","aiForIndividuals":"AI สำหรับบุคคล","aiForStudents":"AI สำหรับนักเรียน","apply":"สมัคร","ariaLabel":"การนำทางทั่วทั้งไซต์","careerAndSkillTracks":"เส้นทางการเรียนด้านอาชีพและทักษะ","dataAnalystDescription":"รวบรวม จัดระเบียบ และวิเคราะห์ข้อมูลสำหรับองค์กรของคุณ","dataEngineerDescription":"สร้างระบบเพื่อจัดการและแปลงข้อมูลดิบ","dataScientistDescription":"ใช้ข้อมูลเพื่อทำความเข้าใจและแก้ไขปัญหาที่ซับซ้อน","docs":"เอกสาร","documents":"เอกสาร","forBusiness":"สำหรับธุรกิจ","forIndividuals":"สำหรับบุคคล","forStudents":"สำหรับนักศึกษา","forUniversities":"สำหรับมหาวิทยาลัย","getANewJob":"หางานใหม่","getHired":"หางานได้","goBack":"ย้อนกลับ","hamburguerButtonAriaLabel":"เปิดเมนูมือถือ","iWantTo":"ฉันต้องการ","improveMySkills":"พัฒนาทักษะของฉัน","jobs":"งาน","jobsAndRecruit":"งานและการสรรหา","latestPodcasts":"พอดแคสต์ล่าสุด","learnAboutAiAndData":"เรียนรู้เกี่ยวกับ AI และข้อมูล","logoAriaLabel":"ไปยังหน้าแรก","machineLearningScientistDescription":"ออกแบบและสร้างระบบ AI เพื่อทำให้โมเดลทำนายเป็นอัตโนมัติ","pastCompetitions":"การแข่งขันที่ผ่านมา","popularTopics":"หัวข้อยอดนิยม","realWorldProjects":"โปรเจกต์จากโลกจริง","seeAll":"ดูทั้งหมด","seeAllBlogs":"ดูบล็อกทั้งหมด","seeAllCheatSheets":"ดู Cheat Sheet ทั้งหมด","seeAllCourses":"ดูคอร์สทั้งหมด","seeAllDatasets":"ดูชุดข้อมูลทั้งหมด","seeAllTechnologies":"ดูเทคโนโลยีทั้งหมด","seeBlogs":"ดูบล็อก","seeTracks":"ดูเส้นทางการเรียน","skillsAssessments":"การประเมินทักษะ","tutorialsAndWebinars":"บทช่วยสอนและ Webinar"},"PlanCard":{"contactUs":"ติดต่อเรา","currentPlan":"แผนปัจจุบัน","hideDetails":"ซ่อนรายละเอียด","seeDetails":"ดูรายละเอียด"},"PricingPageContext":{"startNow":"เริ่มเลย","subscribe":"สมัครรับข่าวสาร"},"QuoteCard":{"link":"อ่านเรื่องราวของ {name}"},"Quotes":{"DevonJoseph":{"quote":"\\"ฉันเคยใช้เว็บไซต์อื่น ทั้ง Coursera, Udacity และอื่นๆ แต่ DataCamp เป็นสิ่งที่ฉันยังคงใช้อยู่\\"","subtext":"Devon Edwards Joseph, Data Engineer, Lloyd\'s Banking Group"},"GabrielLages":{"quote":"\\"ในฐานะผู้จัดการ DataCamp ช่วยฉันแสดง packages ใหม่และวิธีแก้ปัญหาใหม่ให้ทีมได้\\"","subtext":"Gabriel Lages, Business Intelligence and Analytics Manager, Hotmart"},"HarshvardhanDhapola":{"quote":"\\"DataCamp ดีกว่าแพลตฟอร์มการเรียนออนไลน์อื่นที่ฉันเคยลองมา ใช้เวลาน้อยกว่า มีประสิทธิภาพมากกว่า และได้ฝึกปฏิบัติจริง\\"","subtext":"Harshvardhan Dhapola"},"OfentsweLebogo":{"quote":"\\"บน DataCamp คุณเรียนรู้จากผู้เชี่ยวชาญ เมื่อเรียนคอร์ส คุณกำลังเรียนรู้จากผู้สอนที่ดีที่สุดในโลก\\"","subtext":"Ofentswe Lebogo, Data Scientist, Council for Scientific and Industrial Research (CSIR)"},"RachelAltSimmons":{"quote":"“เราคิดว่าการเป็นองค์กรที่ขับเคลื่อนด้วยข้อมูลเป็นความรับผิดชอบของทุกคน ท้ายที่สุด ทุกคนในองค์กรล้วนเกี่ยวข้องกับข้อมูลไม่ทางใดก็ทางหนึ่ง ไม่ว่าบทบาทจะเป็นอะไรก็ตาม”","subtext":"Rachel Alt-Simmons, Head Of Strategic Design, Data, Pricing And Analytics, AXA XL"},"SarahSchlobohm":{"quote":"\\"เราได้ทดลองโซลูชันการเรียนรู้ออนไลน์อื่น ๆ หลายรายการ แต่มีเพียง DataCamp เท่านั้นที่มอบประสบการณ์เชิงโต้ตอบที่เสริมสร้างการเรียนรู้\\"","subtext":"Sarah Schlobohm, Senior Analytics Manager, Global Risk Analytics, HSBC"}},"Search":{"emptyResultMessage":"ไม่พบผลลัพธ์สำหรับการค้นหา","placeholder":"คุณอยากเรียนรู้เรื่องอะไร?","seeAllResults":"กด Enter เพื่อดูผลลัพธ์คอร์สทั้งหมด"},"SignUp":{"title":"ร่วมกับผู้เรียนกว่า<highlight>{count} ล้านคน</highlight>ทั่วโลก"},"SkipToMainContentLink":{"lin