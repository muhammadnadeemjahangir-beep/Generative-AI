ataEngineering":"Memahami Data Engineering","understandingDataScience":"Memahami Data Science","understandingDataVisualization":"Memahami Visualisasi Data","understandingMachineLearning":"Memahami Machine Learning"},"TracksPanel":{"careerTracks":"Career Track","seeAllCareerTracks":"Lihat Semua Career Track","seeAllSkillTracks":"Lihat Semua Skill Track","skillTracks":"Skill Track"},"WorkspaceDocs":{"creatingAPublication":{"description":"Untuk membagikan karya Anda dengan rekan atau menampilkannya di halaman profil Anda, Anda dapat membuat publikasi dari workspace dan mengontrol bagaimana orang lain dapat menemukannya.","label":"Membuat Publikasi"},"creatingAWorkspace":{"description":"Workspace adalah kumpulan file sumber, data, dan konfigurasi yang mewakili semua pekerjaan yang Anda lakukan untuk tugas atau proyek analisis data tertentu.","label":"Membuat Workspace"},"gettingStarted":{"description":"Tutorial ini membantu Anda mendapatkan akses ke DataLab, membuat workspace dari template, dan menerbitkannya. Perkiraan waktu penyelesaian: 10 menit.","label":"Memulai"},"support":{"description":"Kami senang menerima masukan! Jika Anda memiliki saran untuk meningkatkan produk ini, silakan kirimkan pesan kepada kami","label":"Dukungan"},"whatIsDataCampWorkspace":{"description":"DataLab adalah IDE online yang memungkinkan Anda menulis kode dan menganalisis data secara kolaboratif serta membagikan wawasan data Anda.","label":"Apa itu DataLab?"}},"WorkspaceIntegrations":{"dropbox":{"description":"Jika Anda hanya ingin mencoba integrasi ini dengan mengakses file data yang telah ditentukan, Anda dapat melewati bagian selanjutnya dan langsung ke bagian berikutnya.","label":"Dropbox"},"github":{"description":"Anda dapat mengatur username dan password GitHub Anda sebagai variabel lingkungan.","label":"GitHub"},"postgresql":{"description":"Untuk melakukan query database PostgreSQL dari dalam DataLab, langkah pertama adalah membuat integrasi untuk terhubung ke database","label":"Pos