g\xe2n h\xe0ng Lloyd"},"GabrielLages":{"quote":"\\"Trong vai tr\xf2 quản l\xfd, DataCamp gi\xfap t\xf4i hướng dẫn cho nh\xf3m những g\xf3i mới v\xe0 phương ph\xe1p mới để giải quyết vấn đề\\".","subtext":"Gabriel Lages, Quản l\xfd Ph\xe2n t\xedch v\xe0 BI, Hotmart"},"HarshvardhanDhapola":{"quote":"\\"DataCamp tốt hơn nhiều so với c\xe1c nền tảng học trực tuyến kh\xe1c m\xe0 t\xf4i đ\xe3 thử. Nền tảng n\xe0y vừa tiết kiệm thời gian, vừa hiệu quả hơn v\xe0 bạn được thực h\xe0nh trực tiếp\\".","subtext":"Harshvardhan Dhapola"},"OfentsweLebogo":{"quote":"\\"Tr\xean DataCamp, bạn được học hỏi từ c\xe1c chuy\xean gia. Khi tham gia kh\xf3a học, bạn thực sự học từ những giảng vi\xean giỏi nhất thế giới\\".","subtext":"Ofentswe Lebogo, Nh\xe0 khoa học dữ liệu, Hội đồng Nghi\xean cứu Khoa học v\xe0 C\xf4ng nghiệp (CSIR)"},"RachelAltSimmons":{"quote":"\\"Tất cả nh\xe2n vi\xean trong tổ chức đều c\xf3 tr\xe1ch nhiệm t\xecm hiểu về dữ liệu. Sau c\xf9ng th\xec tất cả mọi người đều phải l\xe0m việc với dữ liệu d\xf9 ở bất kỳ vị tr\xed n\xe0o.\\"","subtext":"Rachel Alt-Simmons, Trưởng ph\xf2ng Kế hoạch chiến lược, Dữ liệu, Định gi\xe1 v\xe0 Ph\xe2n t\xedch, AXA XL"},"SarahSchlobohm":{"quote":"\\"Ch\xfang t\xf4i đ\xe3 trải nghiệm thử nhiều giải ph\xe1p học trực tuyến kh\xe1c, nhưng chỉ c\xf3 DataCamp cung cấp trải nghiệm tương t\xe1c th\xfac đẩy việc học\\".","subtext":"Sarah Schlobohm, Quản l\xfd ph\xe2n t\xedch cấp cao, Ph\xe2n t\xedch rủi ro to\xe0n cầu, HSBC"}},"Search":{"emptyResultMessage":"Ch\xfang t\xf4i kh\xf4ng t\xecm thấy kết quả n\xe0o cho t\xecm kiếm n\xe0y","placeholder":"Bạn muốn học g\xec?","seeAllResults":"Nhấn enter để xem tất cả kết quả kh\xf3a học"},"SignUp":{"title":"Tham gia c\xf9ng hơn <highlight>{count} triệu học vi\xean</highlight> tr\xean to\xe0n thế giới"},"SkipToMainContentLink":{"link":"Chuyển đến nội dung ch\xednh"},"WriteForUsLink":{"text":"Viết cho ch\xfang t\xf4i","textExcited":"Viết cho ch\xfang t\xf4i!"}}')},16461:(e,t,n)=>{"use strict";var a=n(368