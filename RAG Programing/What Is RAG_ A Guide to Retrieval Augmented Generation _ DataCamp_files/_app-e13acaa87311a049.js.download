 के साथ मशीन लर्निंग के मूल सिद्धांत","machineLearningScientistWithPython":"पायथन के साथ मशीन लर्निंग साइंटिस्ट","machineLearningScientistWithR":"आर के साथ मशीन लर्निंग साइंटिस्ट","marketingAnalytics":"मार्केटिंग एनालिटिक्स","marketingAnalyticsForBusiness":"व्यवसाय के लिए मार्केटिंग एनालिटिक्स","microsoftAzureFundamentalsAZ900":"Microsoft Azure बुनियादी बातें (AZ-900)","powerBiFundamentals":"पॉवर बीआई के मूल सिद्धांत","pythonDataFundamentals":"पायथन डेटा फंडामेंटल्स","pythonFundamentals":"पायथन के मूल सिद्धांत","pythonProgrammer":"पायथन डेवलपर","pythonProgramming":"पायथन सॉफ्टवेयर विकास","pythonProgrammingToolbox":"पायथन प्रोग्रामिंग टूलबॉक्स","pythonToolbox":"पायथन टूलबॉक्स","rProgrammer":"आर डेवलपर","rProgramming":"आर सॉफ्टवेयर विकास","rProgrammingFundamentals":"आर प्रोग्रामिंग के मूल सिद्धांत","shinyFundamentals":"शाइनी फंडामेंटल्स","snowflakeFoundations":"स्नोफ्लेक फाउंडेशन","spreadsheetFundamentals":"स्प्रेडशीट के मूल सिद्धांत","sqlForBusinessAnalysts":"व्यावसायिक विश्लेषकों के लिए SQL","sqlForDatabaseAdministrators":"डेटाबेस प्रशासकों के लिए SQL","sqlFundamentals":"SQL के मूल सिद्धांत","sqlServerForDatabaseAdministrators":"डेटाबेस प्रशासकों के लिए SQL सर्वर","sqlServerFundamentals":"SQL सर्वर के मूल सिद्धांत","tableauFundamentals":"टेबलू के मूल सिद्धांत","tidyverseFundamentalsWithR":"R के साथ Tidyverse की मूलभूत बातें","understandingCloudComputing":"क्लाउड कंप्यूटिंग को समझना","understandingDataEngineering":"डेटा इंजीनियरिंग को समझना","understandingDataScience":"डेटा साइंस को समझना","understandingDataVisualization":"डेटा विज़ुअलाइज़ेशन को समझना","understandingMachineLearning":"मशीन लर्निंग को समझना"},"TracksPanel":{"careerTracks":"करियर ट्रैक","seeAllCareerTracks":"सभी कैरियर विकल्पों को देखें","seeAllSkillTracks":"सभी कौशल ट्रैक देखें","skillTracks":"कौशल ट्रैक"},"WorkspaceDocs":{"creatingAPublication":{"description":"अपने काम को साथियों के साथ साझा करने या इसे अपने प्रोफ़ाइल पेज पर प्रदर्शित करने के लिए, आप एक वर्कस्पेस से एक प्रकाशन बना सकते हैं और यह नियंत्रित कर सकते हैं कि अन्य लोग इसे कैसे ढूंढ सकते हैं।","label":"प्रकाशन का निर्माण"},"creatingAWorkspace":{"description":"वर्कस्पेस स्रोत, डेटा और कॉन्फ़िगरेशन फ़ाइलों का एक संग्रह है जो किसी विशिष्ट डेटा विश्लेषण कार्य या परियोजना के लिए आपके द्वारा किए जा रहे सभी कार्यों का प्रतिनिधित्व करता है।","label":"कार्यक्षेत्र बनाना"},"gettingStarted":{"description":"यह ट्यूटोरियल आपको DataLab तक पहुंच प्राप्त करने, टेम्पलेट से वर्कस्पेस बनाने और उसे प्रकाशित करने में मदद करेगा। पूरा करने में लगने वाला अनुमानित समय: 10 मिनट।","label":"शुरू करना"},"support":{"description":"हमें आपकी प्रतिक्रिया का स्वागत है! यदि आपके पास उत्पाद को बेहतर बनाने के लिए कोई सुझाव हैं, तो हमें संदेश भेजें।","label":"सहायता"},"whatIsDataCampWorkspace":{"description":"DataLab एक ऑनलाइन IDE है जो आपको सहयोगात्मक रूप से कोड लिखने और डेटा का विश्लेषण करने और अपने डेटा से प्राप्त जानकारियों को साझा करने की अनुमति देता है।","label":"डेटा लैब क्या है?"}},"WorkspaceIntegrations":{"dropbox":{"description":"यदि आप पूर्वनिर्धारित डेटा फ़ाइलों तक पहुँच प्राप्त करके इस एकीकरण को आज़माना चाहते हैं, तो आप अगले भाग को छोड़ सकते हैं और सीधे अगले अनुभाग पर जा सकते हैं।","label":"ड्रॉपबॉक्स"},"github":{"description":"आप अपने GitHub उपयोगकर्ता नाम और पासवर्ड को पर्यावरण चर के रूप में सेट कर सकते हैं।","label":"Github"},"postgresql":{"description":"DataLab के अंदर से PostgreSQL डेटाबेस से क्वेरी करने के लिए, पहला कदम डेटाबेस से कनेक्ट करने के लिए एक एकीकरण बनाना है।","label":"पोस्टग्रेएसक्यूएल"},"redshift":{"description":"DataLab के अंदर से Redshift डेटाबेस से क्वेरी करने के लिए, पहला कदम डेटाबेस से कनेक्ट करने के लिए एक एकीकरण बनाना है।","label":"रेडशिफ्ट"},"s3Bucket":{"description":"अपने वर्कस्पेस को AWS S3 बकेट से कनेक्ट करने के लिए, आपको अपने बकेट का नाम और अपने AWS खाते के क्रेडेंशियल की आवश्यकता होगी।","label":"एस3 बकेट"}},"WorkspacePanel":{"description":"DataCamp के AI-सक्षम डेटा नोटबुक के साथ अपना डेटा पोर्टफोलियो बनाएं।","imageAltText":"वास्तविक समय में सहयोग करें और जानकारी साझा करें","seeAllTemplates":"सभी टेम्पलेट देखें"},"WorkspaceTemplates":{"datasetPythonECommerce":{"description":"कई देशों में सक्रिय एक ऑनलाइन उपहार विक्रेता के ऑर्डर डेटा का विश्लेषण करें।","label":"ई-कॉमर्स डेटा"},"datasetPythonGooglePlayStoreApps":{"description":"आवेदन और उनकी समीक्षाओं से संबंधित डेटा का विश्लेषण करें।","label":"गूगल प्ले स्टोर ऐप्स"},"datasetPythonNetflixMovieData":{"description":"नेटफ्लिक्स पर मौजूद लगभग 8000 फिल्मों और टीवी शो की लंबाई, विवरण, कलाकार, देश आदि जैसे डेटा का विश्लेषण करें।","label":"नेटफ्लिक्स मूवी डेटा"},"playbookPythonMultipleTimeSeries":{"description":"विभिन्न प्रकार के विज़ुअलाइज़ेशन के माध्यम से अपने टाइम सीरीज़ डेटा की गहन समझ प्राप्त करें।","label":"एकाधिक समय श्रृंखलाओं का विश्लेषण करें"},"playbookPythonNetworkAnalysis":{"description":"NetworkX पैकेज का उपयोग करके नेटवर्क विश्लेषण करें।","label":"नेटवर्क विश्लेषण"},"playbookPythonSentimentAnalysis":{"description":"किसी विषय पर लेखक के मत को समझें और उसका अनुमान लगाएं।","label":"भावना विश्लेषण भविष्यवाणी"},"pythonMeasles":{"description":"अमेरिकी स्कूलों से खसरा टीकाकरण डेटा का विश्लेषण करें।","label":"खसरा डेटा"},"recipePythonKMeans":{"description":"अपने डेटा में क्लस्टर की पहचान करें और उन्हें विज़ुअलाइज़ करें।","label":"के-मीन्स का उपयोग करके क्लस्टर खोजें और उनका विज़ुअलाइज़ेशन करें"},"recipePythonTimeSeriesShifts":{"description":"शिफ्ट और लैग की गणना करें और विभिन्न समय अवधियों में प्रतिशत परिवर्तनों को विज़ुअलाइज़ करें।","label":"समय श्रृंखला पर प्रतिशत परिवर्तन, अंतराल और बदलाव की गणना करें"},"recipePythonVisualize2DHeatmapWithHistogram":{"description":"दो आयामों में रंग की विभिन्न छायाओं और तीव्रता के माध्यम से किसी घटना की तीव्रता को प्रदर्शित करें।","label":"हीटमैप को विज़ुअलाइज़ करें"},"recipePythonWordCloud":{"description":"वर्ड क्लाउड की मदद से किसी टेक्स्ट फ़ाइल में सबसे अधिक बार आने वाले शब्दों को विज़ुअलाइज़ करें।","label":"वर्ड क्लाउड बनाएं"}},"aiForBusiness":"व्यवसाय के लिए एआई","aiForEducators":"शिक्षकों के लिए एआई","aiForIndividuals":"व्यक्तियों के लिए एआई","aiForStudents":"छात्रों के लिए एआई","apply":"आवेदन करना","ariaLabel":"साइटव्यापी नेविगेशन","careerAndSkillTracks":"कैरियर और कौशल पथ","dataAnalystDescription":"अपने संगठन के लिए डेटा एकत्र करें, व्यवस्थित करें और उसकी व्याख्या करें।","dataEngineerDescription":"कच्चे डेटा को प्रबंधित और परिवर्तित करने के लिए सिस्टम बनाएं।","dataScientistDescription":"जटिल समस्याओं को समझने और हल करने के लिए डेटा का उपयोग करें।","docs":"डॉक्स","documents":"दस्तावेज़","forBusiness":"व्यवसाय के लिए","forIndividuals":"व्यक्तियों के लिए","forStudents":"छात्रों के लिए","forUniversities":"विश्वविद्यालयों के लिए","getANewJob":"नई नौकरी ढूंढो","getHired":"नौकरी पा जाओ","goBack":"वापस जाओ","hamburguerButtonAriaLabel":"मोबाइल मेनू खोलें","iWantTo":"मैं चाहता हूँ","improveMySkills":"मेरा कौशल सुधारें","jobs":"नौकरियाँ","jobsAndRecruit":"नौकरियां और भर्ती","latestPodcasts":"नवीनतम पॉडकास्ट","learnAboutAiAndData":"एआई और डेटा के बारे में जानें","logoAriaLabel":"होम पेज पर जाएं","machineLearningScientistDescription":"भविष्यवाणी मॉडल को स्वचालित करने के लिए एआई सिस्टम को डिजाइन और विकसित करें।","pastCompetitions":"पिछली प्रतियोगिताएँ","popularTopics":"लोकप्रिय विषय","realWorldProjects":"वास्तविक दुनिया की परियोजनाएँ","seeAll":"सभी देखें","seeAllBlogs":"सभी ब्लॉग देखें","seeAllCheatSheets":"सभी चीट शीट देखें","seeAllCourses":"सभी पाठ्यक्रम देखें","seeAllDatasets":"सभी डेटासेट देखें","seeAllTechnologies":"सभी प्रौद्योगिकियां देखें","seeBlogs":"ब्लॉग देखें","seeTracks":"ट्रैक देखें","skillsAssessments":"कौशल आकलन","tutorialsAndWebinars":"ट्यूटोरियल और वेबिनार"},"PlanCard":{"contactUs":"हमसे संपर्क करें","currentPlan":"वर्तमान योजना","hideDetails":"विवरण छुपाएं","seeDetails":"विस्तृत जानकारी देखें"},"PricingPageContext":{"startNow":"शुरू करें","subscribe":"सदस्यता लें"},"QuoteCard":{"link":"{name} की कहानी पढ़ें"},"Quotes":{"DevonJoseph":{"quote":"\\"मैंने Coursera, Udacity जैसी अन्य साइटों का भी उपयोग किया है, लेकिन DataCamp ही वह साइट है जिसके साथ मैं जुड़ा रहा हूं।\\"","subtext":"डेवन एडवर्ड्स जोसेफ, डेटा इंजीनियर, लॉयड्स बैंकिंग ग्रुप"},"GabrielLages":{"quote":"\\"एक प्रबंधक के रूप में, DataCamp मुझे अपनी टीम को नए पैकेज और समस्याओं को हल करने के नए तरीके दिखाने में मदद करता है।\\"","subtext":"गैब्रियल लैगेस, बिजनेस इंटेलिजेंस और एनालिटिक्स मैनेजर, हॉटमार्ट"},"HarshvardhanDhapola":{"quote":"\\"डेटाकैंप उन सभी ऑनलाइन लर्निंग प्लेटफॉर्म्स से कहीं बेहतर है जिन्हें मैंने आजमाया है। इसमें कम समय लगता है, यह अधिक कुशल है, और आपको व्यावहारिक अनुभव मिलता है।\\"","subtext":"हर्षवर्धन धपोला"},"OfentsweLebogo":{"quote":"\\"डेटाकैंप पर आप विशेषज्ञों से सीखते हैं। कोर्स करते समय, आप वास्तव में दुनिया के सर्वश्रेष्ठ प्रशिक्षकों से सीख रहे होते हैं।\\"","subtext":"ओफेंट्सवे लेबोगो, डेटा साइंटिस्ट, वैज्ञानिक और औद्योगिक अनुसंधान परिषद (सीएसआईआर)"},"RachelAltSimmons":{"quote":"\\"हमारा मानना ​​है कि डेटा-आधारित दृष्टिकोण अपनाना संगठन में हर किसी की जिम्मेदारी है। आखिरकार, हममें से हर कोई किसी न किसी तरह से डेटा से जुड़ा हुआ है, चाहे आपकी भूमिका कुछ भी हो।\\"","subtext":"रेचल ऑल्ट-सिमन्स, हेड ऑफ स्ट्रेटेजिक डिजाइन, डेटा, प्राइसिंग एंड एनालिटिक्स, AXA XL"},"SarahSchlobohm":{"quote":"\\"हमने कई अन्य ऑनलाइन शिक्षण समाधानों का परीक्षण किया है, लेकिन केवल डेटाकैंप ही वह इंटरैक्टिव अनुभव प्रदान करता है जो सीखने को सुदृढ़ करता है।\\"","subtext":"सारा श्लोबॉहम, वरिष्ठ एनालिटिक्स मैनेजर, ग्लोबल रिस्क एनालिटिक्स, एचएसबीसी"}},"Search":{"emptyResultMessage":"हमें खोज का कोई परिणाम नहीं मिला।","placeholder":"आप क्या सीखना चाहेंगे?","seeAllResults":"सभी पाठ्यक्रम परिणाम देखने के लिए एंटर दबाएँ"},"SignUp":{"title":"100 से अधिक लोगों से जुड़ें <highlight> {count} मिलियन शिक्षार्थी</highlight> विश्वव्यापी"},"SkipToMainContentLink":{"link":"मुख्य सामग्री पर जाएं"},"WriteForUsLink":{"text":"हमारे लिए लिखें","textExcited":"हमारे लिए लिखें!"}}')},49364:(e,t,n)=>{"use strict";var a=n(29005);function i(e){return(e>>>24|e>>>8&65280|e<<8&0xff0000|(255&e)<<24)>>>0}function r(e){return 1===e.length?"0"+e:e}function o(e){if(7===e.length)return"0"+e;if(6===e.length)return"00"+e;if(5===e.length)return"000"+e;if(4===e.length)return"00